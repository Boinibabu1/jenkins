<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>MobiVerse — Premium Mobile Store</title>
  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    /* ============================================================
       RESET & ROOT VARIABLES
    ============================================================ */
    *,
    *::before,
    *::after {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    :root {
      --bg: #05060a;
      --bg-soft: #0b0e17;
      --surface: rgba(255, 255, 255, 0.04);
      --surface-hover: rgba(255, 255, 255, 0.08);
      --stroke: rgba(255, 255, 255, 0.08);
      --stroke-light: rgba(255, 255, 255, 0.14);
      --text: #eef2ff;
      --muted: #8a93a8;
      --primary: #3b82f6;
      --primary-glow: #60a5fa;
      --accent: #a855f7;
      --accent-glow: #c084fc;
      --pink: #ec4899;
      --grad: linear-gradient(135deg, #3b82f6 0%, #a855f7 55%, #ec4899 100%);
      --grad-soft: linear-gradient(135deg, rgba(59, 130, 246, 0.15), rgba(168, 85, 247, 0.15));
      --radius-sm: 12px;
      --radius: 20px;
      --radius-lg: 28px;
      --shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.8);
      --transition: 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: 'Plus Jakarta Sans', system-ui, -apple-system, 'Segoe UI', sans-serif;
      background-color: var(--bg);
      color: var(--text);
      line-height: 1.65;
      overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
      position: relative;
    }

    /* Ambient background glows */
    body::before {
      content: '';
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 0;
      background:
        radial-gradient(700px 500px at 10% -5%, rgba(59, 130, 246, 0.20), transparent 70%),
        radial-gradient(800px 600px at 95% 10%, rgba(168, 85, 247, 0.16), transparent 70%),
        radial-gradient(600px 500px at 50% 110%, rgba(236, 72, 153, 0.10), transparent 70%);
    }

    body > * {
      position: relative;
      z-index: 1;
    }

    img {
      max-width: 100%;
      display: block;
    }

    a {
      text-decoration: none;
      color: inherit;
    }

    ul {
      list-style: none;
    }

    button {
      font-family: inherit;
      cursor: pointer;
      border: none;
      background: none;
      color: inherit;
    }

    /* ============================================================
       UTILITY CLASSES
    ============================================================ */
    .container {
      width: 100%;
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 22px;
    }

    .grad-text {
      background: var(--grad);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 9px;
      font-weight: 600;
      font-size: 14px;
      border-radius: 999px;
      padding: 13px 26px;
      white-space: nowrap;
      transition: transform var(--transition), box-shadow var(--transition), background var(--transition), border-color var(--transition);
      border: 1px solid transparent;
    }

    .btn-primary {
      background: var(--grad);
      color: #fff;
      box-shadow: 0 12px 30px -12px rgba(59, 130, 246, 0.8);
    }

    .btn-primary:hover {
      transform: translateY(-3px);
      box-shadow: 0 20px 40px -14px rgba(168, 85, 247, 0.9);
    }

    .btn-ghost {
      background: var(--surface);
      border-color: var(--stroke);
      color: var(--text);
    }

    .btn-ghost:hover {
      background: var(--surface-hover);
      border-color: var(--stroke-light);
      transform: translateY(-3px);
    }

    .btn-sm {
      padding: 9px 18px;
      font-size: 13px;
    }

    .btn-lg {
      padding: 16px 34px;
      font-size: 15px;
    }

    /* ============================================================
       TOP BAR
    ============================================================ */
    .topbar {
      background: linear-gradient(90deg, rgba(59, 130, 246, 0.18), rgba(168, 85, 247, 0.18));
      border-bottom: 1px solid var(--stroke);
      text-align: center;
      font-size: 13px;
      letter-spacing: 0.01em;
      color: #c7d1ea;
      padding: 9px 16px;
    }

    .topbar b {
      color: #fff;
    }

    /* ============================================================
       NAVBAR
    ============================================================ */
    .nav {
      position: sticky;
      top: 0;
      z-index: 1000;
      background: rgba(5, 6, 10, 0.8);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-bottom: 1px solid var(--stroke);
    }

    .nav-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
      height: 74px;
    }

    .logo {
      display: flex;
      align-items: center;
      gap: 11px;
      font-size: 20px;
      font-weight: 800;
      letter-spacing: -0.02em;
      flex-shrink: 0;
    }

    .logo-mark {
      width: 38px;
      height: 38px;
      border-radius: 12px;
      background: var(--grad);
      display: grid;
      place-items: center;
      font-size: 18px;
      color: #fff;
      font-weight: 800;
      box-shadow: 0 10px 26px -10px rgba(59, 130, 246, 0.95);
    }

    .logo span {
      background: var(--grad);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 34px;
    }

    .nav-links a {
      position: relative;
      font-size: 15px;
      font-weight: 500;
      color: var(--muted);
      transition: color var(--transition);
    }

    .nav-links a::after {
      content: '';
      position: absolute;
      left: 0;
      bottom: -7px;
      height: 2px;
      width: 0;
      border-radius: 2px;
      background: var(--grad);
      transition: width var(--transition);
    }

    .nav-links a:hover {
      color: var(--text);
    }

    .nav-links a:hover::after {
      width: 100%;
    }

    .nav-actions {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .icon-btn {
      width: 42px;
      height: 42px;
      border-radius: 50%;
      display: grid;
      place-items: center;
      background: var(--surface);
      border: 1px solid var(--stroke);
      color: var(--muted);
      transition: var(--transition);
      position: relative;
    }

    .icon-btn:hover {
      color: var(--text);
      background: var(--surface-hover);
      transform: translateY(-2px);
      border-color: var(--stroke-light);
    }

    .icon-btn .badge {
      position: absolute;
      top: -4px;
      right: -4px;
      width: 19px;
      height: 19px;
      border-radius: 50%;
      background: linear-gradient(135deg, #ef4444, #f97316);
      color: #fff;
      font-size: 11px;
      font-weight: 700;
      display: grid;
      place-items: center;
      border: 2px solid var(--bg);
    }

    .menu-btn {
      display: none;
    }

    /* ============================================================
       HERO
    ============================================================ */
    .hero {
      padding: 90px 0 100px;
      overflow: hidden;
      position: relative;
    }

    .hero-inner {
      display: grid;
      grid-template-columns: 1.1fr 0.9fr;
      gap: 60px;
      align-items: center;
    }

    .hero-copy .pill {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 18px;
      border-radius: 999px;
      background: rgba(59, 130, 246, 0.12);
      border: 1px solid rgba(59, 130, 246, 0.35);
      color: #a9bcff;
      font-size: 13px;
      font-weight: 600;
      margin-bottom: 26px;
      animation: fadeUp 0.8s ease both;
    }

    .hero h1 {
      font-size: clamp(2.4rem, 5vw, 4.2rem);
      line-height: 1.06;
      letter-spacing: -0.04em;
      font-weight: 800;
      animation: fadeUp 0.8s 0.1s ease both;
    }

    .hero .lead {
      color: var(--muted);
      font-size: 17px;
      max-width: 520px;
      margin: 24px 0 36px;
      animation: fadeUp 0.8s 0.2s ease both;
    }

    .hero-cta {
      display: flex;
      gap: 14px;
      flex-wrap: wrap;
      animation: fadeUp 0.8s 0.3s ease both;
    }

    .hero-stats {
      display: flex;
      gap: 44px;
      margin-top: 52px;
      padding-top: 32px;
      border-top: 1px solid var(--stroke);
      animation: fadeUp 0.8s 0.4s ease both;
    }

    .hero-stats strong {
      display: block;
      font-size: 26px;
      font-weight: 800;
      letter-spacing: -0.02em;
    }

    .hero-stats span {
      font-size: 13px;
      color: var(--muted);
    }

    /* Hero visual — phone mockup */
    .hero-visual {
      position: relative;
      display: grid;
      place-items: center;
      min-height: 580px;
    }

    .phone-mockup {
      width: 280px;
      height: 570px;
      border-radius: 48px;
      padding: 12px;
      background: linear-gradient(160deg, #242c45, #0b0f1a);
      border: 1px solid rgba(255, 255, 255, 0.14);
      box-shadow:
        0 50px 100px -35px rgba(0, 0, 0, 0.95),
        0 0 100px -18px rgba(59, 130, 246, 0.65);
      position: relative;
      z-index: 2;
      animation: float 6s ease-in-out infinite;
    }

    .phone-screen {
      height: 100%;
      border-radius: 37px;
      padding: 16px;
      display: flex;
      flex-direction: column;
      gap: 12px;
      position: relative;
      overflow: hidden;
      background: linear-gradient(165deg, #3b82f6, #a855f7 58%, #ec4899);
    }

    .phone-screen::after {
      content: '';
      position: absolute;
      inset: 0;
      background: radial-gradient(circle at 75% 12%, rgba(255, 255, 255, 0.35), transparent 55%);
      pointer-events: none;
    }

    .notch {
      position: absolute;
      top: 10px;
      left: 50%;
      transform: translateX(-50%);
      width: 90px;
      height: 22px;
      border-radius: 999px;
      background: rgba(5, 6, 10, 0.8);
      z-index: 3;
    }

    .scr-status {
      display: flex;
      justify-content: space-between;
      margin-top: 28px;
      padding: 0 6px;
      font-size: 11px;
      font-weight: 700;
      color: rgba(255, 255, 255, 0.95);
      letter-spacing: 0.04em;
    }

    .scr-card {
      background: rgba(255, 255, 255, 0.18);
      border: 1px solid rgba(255, 255, 255, 0.3);
      border-radius: 20px;
      padding: 16px;
      color: #fff;
      backdrop-filter: blur(8px);
    }

    .scr-tag {
      display: inline-block;
      font-size: 9px;
      font-weight: 800;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      padding: 5px 10px;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.28);
    }

    .scr-card h4 {
      font-size: 20px;
      font-weight: 800;
      margin: 10px 0 3px;
      letter-spacing: -0.02em;
    }

    .scr-card p {
      font-size: 12px;
      opacity: 0.9;
    }

    .scr-bar {
      height: 6px;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.28);
      margin-top: 14px;
      overflow: hidden;
    }

    .scr-bar i {
      display: block;
      height: 100%;
      width: 72%;
      border-radius: 999px;
      background: #fff;
    }

    .scr-tiles {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      margin-top: auto;
    }

    .tile {
      height: 76px;
      border-radius: 16px;
      background: rgba(255, 255, 255, 0.16);
      border: 1px solid rgba(255, 255, 255, 0.24);
    }

    /* Floating cards */
    .float-card {
      position: absolute;
      z-index: 3;
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 14px 18px;
      border-radius: 18px;
      background: rgba(11, 14, 23, 0.85);
      border: 1px solid var(--stroke);
      backdrop-filter: blur(16px);
      box-shadow: 0 25px 50px -22px rgba(0, 0, 0, 0.95);
      font-size: 13px;
    }

    .float-card b {
      display: block;
      font-size: 14px;
      font-weight: 700;
    }

    .float-card small {
      color: var(--muted);
      font-size: 11.5px;
    }

    .fc-icon {
      width: 38px;
      height: 38px;
      border-radius: 12px;
      display: grid;
      place-items: center;
      font-size: 16px;
      background: var(--grad);
      color: #fff;
      flex-shrink: 0;
    }

    .card-a {
      top: 8%;
      left: -6%;
      animation: float 5s ease-in-out infinite;
    }

    .card-b {
      bottom: 10%;
      right: -6%;
      animation: float 7s ease-in-out infinite 0.8s;
    }

    /* ============================================================
       BRANDS STRIP
    ============================================================ */
    .brands {
      padding: 36px 0;
      border-top: 1px solid var(--stroke);
      border-bottom: 1px solid var(--stroke);
    }

    .brands-title {
      text-align: center;
      font-size: 12px;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--muted);
      font-weight: 700;
      margin-bottom: 24px;
    }

    .brand-row {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 16px 56px;
    }

    .brand-row span {
      font-size: 22px;
      font-weight: 800;
      letter-spacing: -0.03em;
      color: rgba(255, 255, 255, 0.22);
      transition: var(--transition);
    }

    .brand-row span:hover {
      color: rgba(255, 255, 255, 0.9);
      transform: translateY(-2px);
    }

    /* ============================================================
       SECTION HEADERS
    ============================================================ */
    section.block {
      padding: 90px 0;
    }

    .sec-head {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 24px;
      margin-bottom: 46px;
    }

    .eyebrow {
      display: inline-block;
      font-size: 12px;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      font-weight: 700;
      color: var(--primary-glow);
      margin-bottom: 10px;
    }

    .sec-head h2 {
      font-size: clamp(1.7rem, 3.5vw, 2.5rem);
      line-height: 1.14;
      letter-spacing: -0.03em;
      font-weight: 800;
    }

    .link-more {
      font-size: 14px;
      font-weight: 600;
      color: var(--muted);
      transition: var(--transition);
      white-space: nowrap;
      padding-bottom: 4px;
    }

    .link-more:hover {
      color: var(--text);
      transform: translateX(4px);
    }

    /* ============================================================
       PRODUCT GRID
    ============================================================ */
    .product-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(245px, 1fr));
      gap: 24px;
    }

    .product {
      background: linear-gradient(180deg, rgba(255, 255, 255, 0.06), rgba(255, 255, 255, 0.02));
      border: 1px solid var(--stroke);
      border-radius: var(--radius);
      overflow: hidden;
      transition: transform var(--transition), border-color var(--transition), box-shadow var(--transition);
    }

    .product:hover {
      transform: translateY(-9px);
      border-color: rgba(168, 85, 247, 0.55);
      box-shadow: 0 34px 65px -32px rgba(59, 130, 246, 0.95);
    }

    .thumb {
      position: relative;
      height: 220px;
      display: grid;
      place-items: center;
      overflow: hidden;
    }

    .thumb::after {
      content: '';
      position: absolute;
      inset: 0;
      background: radial-gradient(circle at 50% 120%, rgba(255, 255, 255, 0.10), transparent 60%);
      pointer-events: none;
    }

    .grad-1 {
      background: radial-gradient(circle at 50% 32%, rgba(59, 130, 246, 0.55), transparent 65%), #0f1424;
    }

    .grad-2 {
      background: radial-gradient(circle at 50% 32%, rgba(168, 85, 247, 0.55), transparent 65%), #0f1424;
    }

    .grad-3 {
      background: radial-gradient(circle at 50% 32%, rgba(236, 72, 153, 0.48), transparent 65%), #0f1424;
    }

    .grad-4 {
      background: radial-gradient(circle at 50% 32%, rgba(34, 211, 238, 0.48), transparent 65%), #0f1424;
    }

    .badge-tag {
      position: absolute;
      top: 14px;
      left: 14px;
      z-index: 2;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.04em;
      padding: 5px 12px;
      border-radius: 999px;
      background: var(--grad);
      color: #fff;
    }

    .badge-tag.sale {
      background: linear-gradient(135deg, #ef4444, #f97316);
    }

    .wish {
      position: absolute;
      top: 12px;
      right: 12px;
      z-index: 2;
      width: 36px;
      height: 36px;
      border-radius: 50%;
      display: grid;
      place-items: center;
      font-size: 16px;
      color: var(--muted);
      background: rgba(5, 6, 10, 0.6);
      border: 1px solid var(--stroke);
      transition: var(--transition);
    }

    .wish:hover {
      color: #ef4444;
      border-color: rgba(239, 68, 68, 0.6);
      transform: scale(1.15);
    }

    .mini-phone {
      width: 78px;
      height: 150px;
      border-radius: 18px;
      padding: 5px;
      background: linear-gradient(160deg, #2a3350, #0c1120);
      border: 1px solid rgba(255, 255, 255, 0.18);
      box-shadow: 0 24px 44px -20px rgba(0, 0, 0, 0.95);
      transition: transform 0.45s cubic-bezier(0.2, 0.8, 0.2, 1);
      position: relative;
      z-index: 1;
    }

    .mini-phone::before {
      content: '';
      display: block;
      height: 100%;
      border-radius: 14px;
      background: linear-gradient(160deg, #3b82f6, #a855f7);
      opacity: 0.9;
    }

    .product:hover .mini-phone {
      transform: translateY(-8px) scale(1.05) rotate(-2deg);
    }

    .product-body {
      padding: 20px 20px 24px;
    }

    .brand-name {
      font-size: 11.5px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      font-weight: 700;
      color: var(--muted);
    }

    .product h3 {
      font-size: 17px;
      font-weight: 700;
      margin: 7px 0 8px;
      letter-spacing: -0.02em;
    }

    .rating {
      font-size: 13px;
      color: #fbbf24;
      letter-spacing: 1px;
    }

    .rating span {
      color: var(--muted);
      letter-spacing: 0;
      font-size: 12.5px;
      margin-left: 5px;
    }

    .price-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-top: 18px;
    }

    .price {
      font-size: 19px;
      font-weight: 800;
      letter-spacing: -0.02em;
    }

    .price s {
      font-size: 13px;
      font-weight: 500;
      color: var(--muted);
      margin-left: 6px;
    }

    /* ============================================================
       CATEGORIES
    ============================================================ */
    .category-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 24px;
    }

    .category-card {
      position: relative;
      border-radius: var(--radius);
      padding: 36px 30px;
      background: var(--surface);
      border: 1px solid var(--stroke);
      overflow: hidden;
      transition: var(--transition);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      min-height: 220px;
    }

    .category-card:hover {
      background: var(--surface-hover);
      border-color: rgba(59, 130, 246, 0.4);
      transform: translateY(-8px);
    }

    .category-card .cat-icon {
      font-size: 32px;
      margin-bottom: 18px;
    }

    .category-card h4 {
      font-size: 20px;
      font-weight: 700;
      letter-spacing: -0.02em;
      margin-bottom: 6px;
    }

    .category-card p {
      font-size: 14px;
      color: var(--muted);
      max-width: 220px;
    }

    .category-card .cat-arrow {
      position: absolute;
      bottom: 30px;
      right: 30px;
      width: 42px;
      height: 42px;
      border-radius: 50%;
      display: grid;
      place-items: center;
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid var(--stroke);
      transition: var(--transition);
    }

    .category-card:hover .cat-arrow {
      background: var(--grad);
      border-color: transparent;
      transform: translateX(4px);
    }

    /* ============================================================
       DEAL BANNER
    ============================================================ */
    .deal-banner {
      display: grid;
      grid-template-columns: 1.2fr 0.8fr;
      gap: 40px;
      align-items: center;
      padding: 52px 48px;
      border-radius: var(--radius-lg);
      background: linear-gradient(120deg, rgba(59, 130, 246, 0.18), rgba(168, 85, 247, 0.14));
      border: 1px solid rgba(168, 85, 247, 0.35);
      position: relative;
      overflow: hidden;
    }

    .deal-banner::before {
      content: '';
      position: absolute;
      width: 400px;
      height: 400px;
      border-radius: 50%;
      background: rgba(59, 130, 246, 0.35);
      filter: blur(120px);
      top: -180px;
      right: -80px;
      pointer-events: none;
    }

    .deal-banner h2 {
      font-size: clamp(1.6rem, 3vw, 2.3rem);
      letter-spacing: -0.03em;
      font-weight: 800;
      line-height: 1.15;
      position: relative;
    }

    .deal-banner p {
      color: #b9c4de;
      font-size: 15px;
      margin: 14px 0 28px;
      position: relative;
      max-width: 460px;
    }

    .deal-banner .deal-price {
      font-size: 26px;
      font-weight: 800;
      letter-spacing: -0.02em;
      position: relative;
    }

    .deal-banner .deal-price s {
